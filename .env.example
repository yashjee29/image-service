# ==============================================================================
# Cash Mod Image Service - Environment Configuration
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Network Binding
PORT=3000
HOST=0.0.0.0

# Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent')
LOG_LEVEL=info

# Service Authentication (Bearer <token> or X-Service-Token: <token>)
SERVICE_AUTH_TOKEN=your-internal-service-secret-token-here
AUTH_ENABLED=false

# In-Memory Render Cache (LRU bounded buffer cache)
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=500
CACHE_MAX_BYTES=104857600
CACHE_TTL_MS=60000

# Concurrency & Backpressure Queue Limits
MAX_CONCURRENT_RENDERS=4
MAX_QUEUE_SIZE=50
RENDER_TIMEOUT_MS=10000

# External Asset Ingestion (Avatar Fetching & SSRF Protection)
ASSET_FETCH_TIMEOUT_MS=5000
MAX_ASSET_SIZE_BYTES=10485760

# Bundled Fonts Directory
FONTS_DIR=./assets/fonts

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
